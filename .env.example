# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is blocked by .gitignore.

# Anthropic (Claude AI) — get from console.anthropic.com
VITE_ANTHROPIC_API_KEY=your_anthropic_key_here

# Google Gemini — get from aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_key_here

# GitHub — get from github.com/settings/tokens
VITE_GITHUB_TOKEN=your_github_token_here

# Firebase — get from console.firebase.google.com → Project Settings
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
